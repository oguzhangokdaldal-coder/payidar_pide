# Bu dosyayı .env olarak kopyalayıp kendi bilgilerinizle doldurun.
# .env asla git'e eklenmez (.gitignore içinde).

# Flask oturum/flash mesajları için rastgele, gizli bir değer üretin:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=degistir-bunu-rastgele-bir-deger-ile

# PayTR Mağaza Paneli > Bilgilerim'den alınır
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
# Test modunda gerçek para çekilmez. Canlıya geçince 0 yapın.
PAYTR_TEST_MODE=1

# /admin/giris için şifre. Boş bırakılırsa admin paneline giriş kapalı olur.
ADMIN_PASSWORD=

# Kapıda ödeme siparişlerinde sahte sipariş önleme: WhatsApp onay botu bağlandığında
# bu URL'e "şu telefona şu kodu gönder" isteği atılır (webhooks.py). Boş bırakılırsa
# webhook çağrısı sessizce atlanır, siparişler yine admin panelinden manuel onaylanabilir.
WHATSAPP_WEBHOOK_URL=
# Bot servisiyle karşılıklı doğrulama için paylaşılan gizli anahtar (rastgele bir değer üretin).
WHATSAPP_WEBHOOK_SECRET=
